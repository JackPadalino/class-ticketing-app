rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isLead() {
      return isSignedIn() && myProfile().role == 'lead';
    }

    // A ticket a student created themselves, which they may edit/delete
    // until the lead completes or closes it.
    function isOwnOpenStudentTicket(t) {
      return t.get('createdBy', null) == request.auth.uid &&
        t.get('createdByRole', null) == 'student' &&
        !(t.status in ['completed', 'closed']);
    }

    // A ticket's data map (for the comments/history subcollections).
    function ticketData(ticketId) {
      return get(/databases/$(database)/documents/tickets/$(ticketId)).data;
    }

    // Assignee, or anyone the ticket was shared with (visibleTo). Tickets
    // created before sharing existed have no visibleTo, hence the default.
    function canSeeTicket(t) {
      return t.assignedTo == request.auth.uid || request.auth.uid in t.get('visibleTo', []);
    }

    // ---- users ----
    // Profiles are created only by the seed script (Admin SDK), which
    // bypasses these rules entirely. The one thing a client can write is
    // its own alertPrefs (the lead's Dashboard alert toggles) - nothing
    // else on a profile is client-editable. Student profiles are readable
    // by every signed-in user so a student can pick classmates when
    // creating a ticket (assign it / choose who can see it).
    match /users/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || isLead() || resource.data.role == 'student');
      allow create, delete: if false;
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alertPrefs']);
    }

    // ---- settings ----
    // A single global config doc (settings/global) the lead controls from
    // Settings -> Administrative, e.g. allowStudentStatusUpdates. Readable
    // by everyone (students need to know whether they're currently
    // allowed to change ticket status), writable only by the lead.
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isLead();
    }

    // ---- projects ----
    // Class-wide: every signed-in user (lead or student) can see every
    // project. Only the lead can create/edit/delete them.
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isLead();
    }

    // ---- tickets ----
    match /tickets/{ticketId} {
      // Students see tickets assigned to them or shared with them
      // (visibleTo). The lead sees everything.
      allow read: if isLead() ||
        (isSignedIn() &&
          (resource.data.assignedTo == request.auth.uid ||
            request.auth.uid in resource.data.visibleTo));

      // A student may create a ticket on their own behalf: it starts at
      // ready_to_start, unreviewed, assigned to a real student, and is
      // visible to its creator and its assignee (plus whoever else they
      // pick) so the creator never loses sight of it.
      allow create: if isLead() || (
        isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdByRole == 'student' &&
        request.resource.data.status == 'ready_to_start' &&
        request.resource.data.needsRevision == false &&
        request.resource.data.reviewedBy == null &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.links.size() == 0 &&
        request.resource.data.visibleTo is list &&
        request.resource.data.visibleTo.size() <= 60 &&
        request.auth.uid in request.resource.data.visibleTo &&
        request.resource.data.assignedTo in request.resource.data.visibleTo &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.assignedTo)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.assignedTo)).data.role == 'student' &&
        exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
      );

      // The lead can delete any ticket; a student only one they created
      // (and while it is still open).
      allow delete: if isLead() || (isSignedIn() && isOwnOpenStudentTicket(resource.data));

      // Lead can change anything. A student who owns the ticket may only
      // flip it between the working statuses and edit their links -
      // they can never touch title/description/phase/assignedTo, and
      // never set status to 'completed' themselves (only the lead's
      // approval does that). Editing links alone (status unchanged) is
      // always allowed while the ticket isn't completed or closed (a
      // closed ticket is locked entirely for the student); actually
      // changing status additionally requires the lead's
      // settings/global.allowStudentStatusUpdates toggle to not be off
      // (missing doc/field defaults to allowed, matching the client).
      //
      // A student who created the ticket can also edit its title,
      // description, phase, due date, assignee and visibleTo (never its
      // status or review fields), as long as it stays visible to them and
      // to a real student assignee.
      allow update: if isLead() || (
        isSignedIn() &&
        isOwnOpenStudentTicket(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'description', 'phase', 'dueDate', 'assignedTo', 'assignedToName', 'visibleTo', 'updatedAt']) &&
        request.resource.data.visibleTo is list &&
        request.resource.data.visibleTo.size() <= 60 &&
        request.auth.uid in request.resource.data.visibleTo &&
        request.resource.data.assignedTo in request.resource.data.visibleTo &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.assignedTo)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.assignedTo)).data.role == 'student'
      ) || (
        isSignedIn() &&
        resource.data.assignedTo == request.auth.uid &&
        !(resource.data.status in ['completed', 'closed']) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'links', 'updatedAt']) &&
        (
          request.resource.data.status == resource.data.status ||
          (
            request.resource.data.status in ['ready_to_start', 'in_progress', 'ready_for_review', 'need_support'] &&
            (
              !exists(/databases/$(database)/documents/settings/global) ||
              get(/databases/$(database)/documents/settings/global).data.allowStudentStatusUpdates != false
            )
          )
        )
      );

      match /comments/{commentId} {
        allow read: if isLead() ||
          (isSignedIn() && canSeeTicket(ticketData(ticketId)));
        // Either the lead or a student who can see the ticket (assignee or
        // shared with) can post a comment, but only as themselves and with
        // the role that actually matches who they are - a student can't
        // stamp authorRole 'lead' on one. Students can't comment on a
        // ticket the lead has closed.
        allow create: if isSignedIn() &&
          request.resource.data.authorId == request.auth.uid &&
          (
            (isLead() && request.resource.data.authorRole == 'lead') ||
            (request.resource.data.authorRole == 'student' &&
              canSeeTicket(ticketData(ticketId)) &&
              ticketData(ticketId).status != 'closed')
          );
        // Only the lead who wrote a comment can edit it, and only its
        // text - delete stays broad (not author-restricted) so a cascade
        // delete (a project, or a student deleting their own ticket) can
        // still remove every comment.
        allow update: if isLead() &&
          resource.data.authorId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']);
        allow delete: if isLead() ||
          (isSignedIn() && isOwnOpenStudentTicket(ticketData(ticketId)));
      }

      // System-logged lifecycle events (created, started, submitted for
      // review, needs revision, approved, ...) - visible to the same
      // people as the ticket itself. Either role can log one, but only
      // as themselves; the assignee logs status changes and the creator
      // logs "created" (they may be different students).
      // Students can't log one on a ticket the lead has closed.
      match /history/{eventId} {
        allow read: if isLead() ||
          (isSignedIn() && canSeeTicket(ticketData(ticketId)));
        allow create: if isSignedIn() &&
          request.resource.data.actorId == request.auth.uid &&
          (
            isLead() ||
            ((ticketData(ticketId).assignedTo == request.auth.uid ||
                ticketData(ticketId).get('createdBy', null) == request.auth.uid) &&
              ticketData(ticketId).status != 'closed')
          );
        allow update: if false;
        allow delete: if isLead() ||
          (isSignedIn() && isOwnOpenStudentTicket(ticketData(ticketId)));
      }
    }

    // ---- notifications ----
    // Five kinds: "ready_for_review", "student_comment", and
    // "need_support" (a student -> the lead, no single recipient - the
    // lead's Dashboard can toggle which of these it wants to see), and
    // "ticket_reviewed" and "lead_comment" (the lead -> the specific
    // student, via recipientId).
    match /notifications/{notificationId} {
      // Readable/deletable by the person who triggered it too, so a student
      // deleting their own ticket can clear the alerts about it.
      allow read: if isLead() ||
        (isSignedIn() && (resource.data.recipientId == request.auth.uid ||
          resource.data.actorId == request.auth.uid));
      allow update: if isLead() ||
        (isSignedIn() && resource.data.recipientId == request.auth.uid);
      allow delete: if isLead() ||
        (isSignedIn() && (resource.data.recipientId == request.auth.uid ||
          resource.data.actorId == request.auth.uid));
      allow create: if isSignedIn() && (
        (request.resource.data.type in ['ready_for_review', 'student_comment', 'need_support'] &&
          request.resource.data.actorId == request.auth.uid) ||
        (isLead() && request.resource.data.type in ['ticket_reviewed', 'lead_comment'] &&
          request.resource.data.actorId == request.auth.uid)
      );
    }
  }
}
