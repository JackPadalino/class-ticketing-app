rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isLead() {
      return isSignedIn() && myProfile().role == 'lead';
    }

    // ---- users ----
    // Profiles are created only by the seed script (Admin SDK), which
    // bypasses these rules entirely. The one thing a client can write is
    // its own alertPrefs (the lead's Dashboard alert toggles) - nothing
    // else on a profile is client-editable.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isLead());
      allow create, delete: if false;
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alertPrefs']);
    }

    // ---- projects ----
    // Class-wide: every signed-in user (lead or student) can see every
    // project. Only the lead can create/edit/delete them.
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isLead();
    }

    // ---- tickets ----
    match /tickets/{ticketId} {
      allow read: if isLead() ||
        (isSignedIn() && resource.data.assignedTo == request.auth.uid);

      allow create: if isLead();

      allow delete: if isLead();

      // Lead can change anything. A student who owns the ticket may only
      // flip it between the working statuses and edit their links -
      // they can never touch title/description/phase/assignedTo, and
      // never set status to 'completed' themselves (only the lead's
      // approval does that). Editing links alone (status unchanged) is
      // always allowed regardless of which non-completed status it's in.
      allow update: if isLead() || (
        isSignedIn() &&
        resource.data.assignedTo == request.auth.uid &&
        resource.data.status != 'completed' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'links', 'updatedAt']) &&
        (
          request.resource.data.status == resource.data.status ||
          request.resource.data.status in ['ready_to_start', 'in_progress', 'ready_for_review']
        )
      );

      match /comments/{commentId} {
        allow read: if isLead() ||
          (isSignedIn() &&
            get(/databases/$(database)/documents/tickets/$(ticketId)).data.assignedTo == request.auth.uid);
        // Either the lead or the ticket's own student can post a comment,
        // but only as themselves and with the role that actually matches
        // who they are - a student can't stamp authorRole 'lead' on one.
        allow create: if isSignedIn() &&
          request.resource.data.authorId == request.auth.uid &&
          (
            (isLead() && request.resource.data.authorRole == 'lead') ||
            (request.resource.data.authorRole == 'student' &&
              get(/databases/$(database)/documents/tickets/$(ticketId)).data.assignedTo == request.auth.uid)
          );
        // Only the lead who wrote a comment can edit it, and only its
        // text - delete stays broad (isLead(), not author-restricted) so
        // a project's cascade delete can still remove every comment.
        allow update: if isLead() &&
          resource.data.authorId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']);
        allow delete: if isLead();
      }

      // System-logged lifecycle events (created, started, submitted for
      // review, needs revision, approved, ...) - visible to the same
      // people as the ticket itself. Either role can log one, but only
      // as themselves.
      match /history/{eventId} {
        allow read: if isLead() ||
          (isSignedIn() &&
            get(/databases/$(database)/documents/tickets/$(ticketId)).data.assignedTo == request.auth.uid);
        allow create: if isSignedIn() &&
          request.resource.data.actorId == request.auth.uid &&
          (
            isLead() ||
            get(/databases/$(database)/documents/tickets/$(ticketId)).data.assignedTo == request.auth.uid
          );
        allow update: if false;
        allow delete: if isLead();
      }
    }

    // ---- notifications ----
    // Four kinds: "ready_for_review" and "student_comment" (a student ->
    // the lead, no single recipient - the lead's Dashboard can toggle
    // which of these it wants to see), and "ticket_reviewed" and
    // "lead_comment" (the lead -> the specific student, via recipientId).
    match /notifications/{notificationId} {
      allow read, update: if isLead() ||
        (isSignedIn() && resource.data.recipientId == request.auth.uid);
      allow delete: if isLead();
      allow create: if isSignedIn() && (
        (request.resource.data.type in ['ready_for_review', 'student_comment'] &&
          request.resource.data.actorId == request.auth.uid) ||
        (isLead() && request.resource.data.type in ['ticket_reviewed', 'lead_comment'] &&
          request.resource.data.actorId == request.auth.uid)
      );
    }
  }
}
